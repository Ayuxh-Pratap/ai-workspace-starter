{
  "name": "ai-workspace-starter",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source AI chat workspace starter: Next.js 16, React 19, TypeScript, Tailwind CSS 4 and AlignUI's free base components, with a DESIGN.md design system checked against the CSS.",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "alignui",
    "radix-ui",
    "ai",
    "chat",
    "starter",
    "template",
    "design-system",
    "design-md"
  ],
  "homepage": "https://github.com/Ayuxh-Pratap/ai-workspace-starter#readme",
  "bugs": {
    "url": "https://github.com/Ayuxh-Pratap/ai-workspace-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayuxh-Pratap/ai-workspace-starter.git"
  },
  "license": "MIT",
  "author": "Ayush Pratap Singh (https://github.com/Ayuxh-Pratap)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "design:lint": "designmd lint DESIGN.md",
    "design:check": "node scripts/design-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run design:lint && npm run design:check && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@remixicon/react": "4.9.0",
    "clsx": "2.1.1",
    "merge-refs": "2.0.1",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.19"
  }
}
